{
  "kind": "service",
  "ci": {
    "with": {
      "setup": "make venv",
      "test": "make functional",
      "shellcheck": "with-secrets k8s/admin/e2e.sh",
      "sonar-args": "-Dsonar.sources=src,k8s,Dockerfile -Dsonar.tests=tests"
    }
  },
  "protect": {
    "checks": [
      "ci / passed",
      "integrations / scan"
    ],
    "tags": false
  },
  "secrets": [
    {
      "from": "sustenaut-deploy-ssh-key",
      "to": "SUSTENAUT_DEPLOY_SSH_KEY",
      "kind": "secret"
    },
    {
      "from": "TS_GH_OAUTH_CLIENT_ID",
      "to": "TS_GH_OAUTH_CLIENT_ID",
      "kind": "secret"
    },
    {
      "from": "TS_GH_OAUTH_SECRET",
      "to": "TS_GH_OAUTH_SECRET",
      "kind": "secret"
    },
    {
      "from": "sustenaut-server",
      "to": "SUSTENAUT_SERVER",
      "kind": "variable"
    },
    {
      "from": "sustenaut-known-hosts",
      "to": "SUSTENAUT_KNOWN_HOSTS",
      "kind": "variable"
    }
  ],
  "variables": {
    "names": [
      "NOTIFIER_ROUTES"
    ],
    "deploy": "deploy.yml"
  },
  "deploy": {
    "providers": [{"distribution": "pubdeploy", "wheel": "https://github.com/Sustenaut/pubdeploy/releases/download/v0.4.2/pubdeploy-0.4.2-py3-none-any.whl", "sha256": "e2da970e5f228e955dc7bca5f359df0008361247cbaaae8b38dcadde163a6aaa"}, {"distribution": "pubsec", "wheel": "https://github.com/Sustenaut/pubsec/releases/download/v0.2.3/pubsec-0.2.3-py3-none-any.whl", "sha256": "4a0b9435ff111565265f330fa3a1642b59562d77b5d1806c1bfecfe83e63b106"}],
    "namespace": "notifier",
    "workflow": "deploy.yml",
    "gate": "DEPLOY_NOTIFIER",
    "needs": [
      {
        "type": "gcp.workload-identity",
        "account": "notifier-reader",
        "project": "sustenaut",
        "serviceaccount": "app",
        "pool": "projects/948171295184/locations/global/workloadIdentityPools/services",
        "granted_in": "Sustenaut/shared-infra's infra/services-identity.tf"
      },
      {
        "type": "bitwarden.secret",
        "name": "slack-bot-token",
        "secret": {
          "name": "notifier-secrets",
          "key": "slack-token"
        }
      },
      {
        "type": "upstream",
        "name": "storage",
        "health": "https://storage.sustenaut.eu/"
      },
      {
        "type": "storage.tenant",
        "name": "notifier",
        "storage": "Sustenaut/storage",
        "url": "https://storage.sustenaut.eu",
        "read": [
          "k8s:notifier/app"
        ],
        "write": [
          "k8s:notifier/app"
        ],
        "private": true,
        "heads": true
      },
      {
        "type": "storage.tenant",
        "name": "calls-notifier",
        "storage": "Sustenaut/storage",
        "url": "https://storage.sustenaut.eu",
        "write": [
          "k8s:notifier/app"
        ],
        "private": true,
        "inbox": true
      },
      {
        "type": "github.variable-entry",
        "repository": "Sustenaut/notifier",
        "variable": "NOTIFIER_ROUTES",
        "path": "/default"
      },
      {
        "type": "github.variable-entry",
        "repository": "Sustenaut/notifier",
        "variable": "NOTIFIER_ROUTES",
        "path": "/subjects/notifier~1e2e"
      },
      {
        "type": "github.variable-entry",
        "repository": "Sustenaut/integrations",
        "variable": "INGEST_DATASETS",
        "path": "/notifier",
        "value": "calls_notifier"
      },
      {
        "type": "github.variable-entry",
        "repository": "Sustenaut/observability",
        "variable": "OBSERVABILITY_SENDERS",
        "path": "/notifier/notifier",
        "value": "always"
      },
      {
        "type": "github.variable-entry",
        "repository": "Sustenaut/observability",
        "variable": "OBSERVABILITY_SENDERS",
        "path": "/notifier/e2e",
        "value": "always"
      },
      {
        "type": "k8s.cronjob",
        "name": "notifier"
      },
      {
        "type": "k8s.cronjob",
        "name": "fake-sender"
      }
    ]
  },
  "mirror": {
    "wheels": "https://storage.sustenaut.eu/wheels",
    "terraform": "https://storage.sustenaut.eu/terraform",
    "pypi": "https://storage.sustenaut.eu/pypi"
  }
}
