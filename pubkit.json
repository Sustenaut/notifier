{
  "kind": "service",
  "ci": {
    "with": {
      "setup": "make venv",
      "test": "make functional",
      "shellcheck": "with-secrets k8s/admin/e2e.sh",
      "sonar-args": "-Dsonar.sources=src,k8s,Dockerfile -Dsonar.tests=tests"
    }
  },
  "protect": {
    "checks": [
      "ci / passed",
      "integrations / scan"
    ],
    "tags": false
  },
  "secrets": [
    {
      "from": "sustenaut-deploy-ssh-key",
      "to": "SUSTENAUT_DEPLOY_SSH_KEY",
      "kind": "secret"
    },
    {
      "from": "TS_GH_OAUTH_CLIENT_ID",
      "to": "TS_GH_OAUTH_CLIENT_ID",
      "kind": "secret"
    },
    {
      "from": "TS_GH_OAUTH_SECRET",
      "to": "TS_GH_OAUTH_SECRET",
      "kind": "secret"
    },
    {
      "from": "sustenaut-server",
      "to": "SUSTENAUT_SERVER",
      "kind": "variable"
    },
    {
      "from": "sustenaut-known-hosts",
      "to": "SUSTENAUT_KNOWN_HOSTS",
      "kind": "variable"
    }
  ],
  "variables": {
    "names": [
      "NOTIFIER_ROUTES"
    ],
    "deploy": "deploy.yml"
  },
  "deploy": {
    "providers": [{"distribution": "pubdeploy", "wheel": "https://github.com/Sustenaut/pubdeploy/releases/download/v0.3.0/pubdeploy-0.3.0-py3-none-any.whl", "sha256": "f569e8cbb50e869b8e856bd15d178ccacf2c62e40b1cf278fde807847706fb07"}, {"distribution": "pubsec", "wheel": "https://github.com/Sustenaut/pubsec/releases/download/v0.1.2/pubsec-0.1.2-py3-none-any.whl", "sha256": "88a68ffd252b49289ae02d0a9f629f3e0f0832c921cb8ee0f1301f958527de17"}],
    "namespace": "notifier",
    "workflow": "deploy.yml",
    "gate": "DEPLOY_NOTIFIER",
    "needs": [
      {
        "type": "gcp.service-account-key",
        "account": "notifier-reader",
        "project": "sustenaut",
        "bitwarden": "notifier-reader-key",
        "secret": {
          "name": "notifier-secrets",
          "key": "bigquery-key.json",
          "decode": "base64"
        }
      },
      {
        "type": "bitwarden.secret",
        "name": "slack-bot-token",
        "secret": {
          "name": "notifier-secrets",
          "key": "slack-token"
        }
      },
      {
        "type": "upstream",
        "name": "storage",
        "health": "https://storage.sustenaut.eu/"
      },
      {
        "type": "storage.tenant",
        "name": "notifier",
        "storage": "Sustenaut/storage",
        "url": "https://storage.sustenaut.eu",
        "read": [
          "k8s:notifier/app"
        ],
        "write": [
          "k8s:notifier/app"
        ],
        "private": true,
        "heads": true
      },
      {
        "type": "storage.tenant",
        "name": "calls-notifier",
        "storage": "Sustenaut/storage",
        "url": "https://storage.sustenaut.eu",
        "write": [
          "k8s:notifier/app"
        ],
        "private": true,
        "inbox": true
      },
      {
        "type": "github.variable-entry",
        "repository": "Sustenaut/notifier",
        "variable": "NOTIFIER_ROUTES",
        "path": "/default"
      },
      {
        "type": "github.variable-entry",
        "repository": "Sustenaut/notifier",
        "variable": "NOTIFIER_ROUTES",
        "path": "/subjects/notifier~1e2e"
      },
      {
        "type": "github.variable-entry",
        "repository": "Sustenaut/integrations",
        "variable": "INGEST_DATASETS",
        "path": "/notifier",
        "value": "calls_notifier"
      },
      {
        "type": "github.variable-entry",
        "repository": "Sustenaut/observability",
        "variable": "OBSERVABILITY_SENDERS",
        "path": "/notifier/notifier",
        "value": "always"
      },
      {
        "type": "github.variable-entry",
        "repository": "Sustenaut/observability",
        "variable": "OBSERVABILITY_SENDERS",
        "path": "/notifier/e2e",
        "value": "always"
      },
      {
        "type": "k8s.cronjob",
        "name": "notifier"
      },
      {
        "type": "k8s.cronjob",
        "name": "fake-sender"
      }
    ]
  },
  "mirror": {
    "wheels": "https://storage.sustenaut.eu/wheels",
    "terraform": "https://storage.sustenaut.eu/terraform",
    "pypi": "https://storage.sustenaut.eu/pypi"
  }
}
